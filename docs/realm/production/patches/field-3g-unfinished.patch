+
+/** 판 밖으로 넓히는 줄 수 (위·아래 각각) */
+const EDGE_ROWS = 40
+/** 물 같은 바닥 (판 밖으로 이어 그린다) */
+const WETS: ReadonlySet<number> = new Set([SHALLOW, DEEP, MUD, ICE, FORD, RIVER])
+/**
+ * 판 위아래로 EDGE_ROWS 줄씩 넓힌 칸 (그리기 전용) — 끝 줄의 물 칸을 끝 여섯 줄의 기울기대로 비켜 이어 놓는다 · 물 아닌 칸은 평지 ·
+ * 언덕 자리도 그만큼 내린다
+ */
+function extend(m: VModel): VModel {
+  const U = m.mapU, W = m.mapW, W2 = W + 2 * EDGE_ROWS
+  const cells = new Uint8Array(U * W2)
+  for (let cu = 0; cu < U; cu++) for (let v = 0; v < W; v++) cells[cu * W2 + v + EDGE_ROWS] = m.cells[cu * W + v]!
+  const firstWet = (v: number): number => { for (let cu = 0; cu < U; cu++) if (WETS.has(m.cells[cu * W + v]!)) return cu; return -1 }
+  for (const [edge, inner, dir] of [[0, 6, -1], [W - 1, W - 7, 1]] as const) {
+    const a = firstWet(edge), b = firstWet(inner)
+    if (a < 0) continue
+    const slope = b < 0 ? 0 : (a - b) / 6
+    for (let k = 1; k <= EDGE_ROWS; k++) {
+      const shift = Math.round(slope * k), v2 = EDGE_ROWS + edge + dir * k
+      for (let cu = 0; cu < U; cu++) {
+        const g = m.cells[cu * W + edge]!, to = cu + shift
+        if (!WETS.has(g) || to < 0 || to >= U) continue
+        cells[to * W2 + v2] = g === FORD ? SHALLOW : g
+      }
+    }
+  }
+  return { ...m, cells, mapW: W2, hills: m.hills.map(h => ({ lobes: h.lobes.map(l => ({ ...l, v: l.v + EDGE_ROWS })) })) }
